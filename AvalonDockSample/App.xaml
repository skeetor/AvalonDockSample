<Application x:Class="AvalonDockSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AvalonDockSample"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MLib;component/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AvalonDockSample;component/Themes/VS2013/DarkBrushsExtended.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AvalonDockSample;component/Themes/VS2013/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AvalonDockSample;component/Themes/VS2013/Controls/VsResizeGrip.xaml" />

                <ResourceDictionary>
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    <BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
